server {
    listen 5001;
    server_name _;

    location / {
        proxy_pass http://trace-viewer:5001;
        proxy_set_header Authorization "Bearer $NOOA_VIEWER_AUTH_TOKEN";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }
}
